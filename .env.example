# Copy to .env and fill in SECRET_KEY.  Never commit .env itself.
#
# SECRET_KEY is REQUIRED: settings.py refuses to start without it, because a
# fallback key in the source would let a deployment sign sessions, cookies and
# CSRF tokens with a value published in this repository.  Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Instructor accounts grant course-authoring rights, so self-service signup for
# that role is OFF by default; grant the role to a trusted account in Django
# admin instead.  Set this to True only for a throw-away demo environment that
# wants visitors to be able to create courses themselves.
ALLOW_INSTRUCTOR_SELF_SIGNUP=False

# Optional: where SQLite keeps its file.  Defaults to ./db.sqlite3; the Docker
# setup points this at a mounted volume so data survives restarts.
# DATABASE_PATH=db.sqlite3
